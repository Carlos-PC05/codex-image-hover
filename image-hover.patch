+    #[test]
+    fn image_hover_enlarges_the_original_and_removes_the_overlay() {
+        use crate::pets::ImageProtocol;
+        use crate::transcript_image::ImageHover;
+        use crate::transcript_image::ImagePlacement;
+        use crate::transcript_image::TranscriptImage;
+        use std::sync::Arc;
+
+        let dir = tempfile::tempdir().unwrap();
+        let path = dir.path().join("source.png");
+        image::RgbaImage::from_pixel(640, 480, image::Rgba([10, 110, 200, 255]))
+            .save(&path)
+            .unwrap();
+        let image = Arc::new(TranscriptImage::load(&path, 40, ImageProtocol::Kitty).unwrap());
+        let mut terminal =
+            Terminal::with_options(CaptureBackend::new(/*width*/ 80, /*height*/ 30)).unwrap();
+        let size = terminal.last_known_screen_size;
+        let viewport = Rect::new(0, 0, size.width, size.height);
+        terminal.set_viewport_area(viewport);
+        let thumbnail = Rect::new(2, 24, image.columns, image.rows);
+        let mut retained = Vec::new();
+        let mut hover = ImageHover::default();
+        for position in [(2, 24).into(), (3, 24).into(), (1, 24).into()] {
+            terminal
+                .draw_with_size(size, &mut retained, |frame| {
+                    frame.image_placements.push(ImagePlacement {
+                        image: Arc::clone(&image),
+                        area: thumbnail,
+                        first_row: 0,
+                        file: None,
+                    });
+                    hover.paint(frame, position);
+                })
+                .unwrap();
+            if thumbnail.contains(position) {
+                assert_eq!(retained.len(), 2);
+                let overlay = &retained[1];
+                assert!(overlay.image.pixels.width() > image.pixels.width());
+                assert_eq!(overlay.area.intersection(viewport), overlay.area);
+                assert!(!overlay.area.intersects(thumbnail));
+            } else {
+                assert_eq!(retained.len(), 1);
+            }
+        }
+        let output = terminal.backend().output();
+        assert_eq!(output.matches(",z=1").count(), 1);
+        assert!(output.contains("_Ga=d,d=I,i=49409"));
+    }
