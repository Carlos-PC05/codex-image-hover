+#[derive(Default)]
+pub(crate) struct ImageHover {
+    // Keep one enlarged raster, even when the pointer briefly leaves its thumbnail.
+    cached: Option<(Arc<TranscriptImage>, u16, u16, Option<Arc<TranscriptImage>>)>,
+}
+
+impl ImageHover {
+    pub(crate) fn target(
+        placements: &[ImagePlacement],
+        position: Option<Position>,
+    ) -> Option<&ImagePlacement> {
+        let position = position?;
+        placements.iter().rev().find(|placement| {
+            placement.image.source.is_some()
+                && placement.image.protocol != ImageProtocol::Sixel
+                && placement.area.contains(position)
+        })
+    }
+
+    pub(crate) fn paint(&mut self, frame: &mut crate::custom_terminal::Frame, position: Position) {
+        let Some(target) = Self::target(&frame.image_placements, Some(position)) else {
+            return;
+        };
+        let viewport = frame.area();
+        let above = target.area.y.saturating_sub(viewport.y);
+        let below = viewport.bottom().saturating_sub(target.area.bottom());
+        let width = viewport.width.saturating_sub(2).min(96);
+        let height = above.max(below).saturating_sub(1).min(22);
+        if width < 8 || height < 4 {
+            return;
+        }
+        if !self.cached.as_ref().is_some_and(|(source, w, h, _)| {
+            Arc::ptr_eq(source, &target.image) && (*w, *h) == (width, height)
+        }) {
+            let (cell_width, cell_height) = terminal_cell_size().unwrap_or((8, 16));
+            let image = target.image.source.as_deref().and_then(|path| {
+                let pixels = TranscriptImage::load_pixels(
+                    path,
+                    (u32::from(width) * cell_width).min(1024),
+                    (u32::from(height) * cell_height).min(640),
+                )?;
+                Some(Arc::new(TranscriptImage {
+                    source: None,
+                    protocol: target.image.protocol,
+                    columns: pixels.width().div_ceil(cell_width) as u16,
+                    rows: pixels.height().div_ceil(cell_height) as u16,
+                    pixels,
+                    cell_width,
+                    cell_height,
+                }))
+            });
+            self.cached = Some((Arc::clone(&target.image), width, height, image));
+        }
+        let Some((_, _, _, Some(image))) = &self.cached else {
+            return;
+        };
+        let x = target
+            .area
+            .x
+            .clamp(viewport.x, viewport.right() - image.columns);
+        let y = if above >= below {
+            target.area.y - image.rows - 1
+        } else {
+            target.area.bottom() + 1
+        };
+        frame.image_placements.push(ImagePlacement {
+            image: Arc::clone(image),
+            area: Rect::new(x, y, image.columns, image.rows),
+            first_row: 0,
+            file: None,
+        });
+    }
+}
